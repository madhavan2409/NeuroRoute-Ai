# SmartRoute AI - Environment Variables
# Application Mode: 'demo' (deterministic simulation, no API keys needed) or 'live' (real LLM APIs)
APP_MODE=demo

# Database URL (SQLite for local development, easily migrated to PostgreSQL)
DATABASE_URL=sqlite:///./smartroute.db

# Optional AI Provider API Keys for LIVE Mode
GEMINI_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=
ANTHROPIC_API_KEY=

# Semantic Caching
SEMANTIC_CACHE_ENABLED=true
SEMANTIC_CACHE_THRESHOLD=0.88

# Classification Confidence Calibration Thresholds
CONFIDENCE_HIGH_THRESHOLD=0.75
CONFIDENCE_LOW_THRESHOLD=0.50

# FinOps Policy Defaults
MAX_REQUESTS_PER_MINUTE=60
