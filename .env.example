# ==============================================================================
# PS06: Event Registration System - Environment Configuration
# ==============================================================================
#
# NOTE: The application features Zero-Config Local Demo Mode.
# If these variables are not provided, it runs locally in demo mode with full
# functionality (persisted in localStorage).
#
# To connect to your Supabase PostgreSQL instance:
# 1. Create a project at https://supabase.com
# 2. Run the SQL script from `supabase/schema.sql` in the Supabase SQL Editor
# 3. Copy your Project URL and Anon Public Key below:

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here
